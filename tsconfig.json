{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ES2022.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "dom-speech-recognition"
    ],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src"
  ]
}
